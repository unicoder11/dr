# Shared local development — copy to .env and fill values.
# Never commit real secrets.

# Postgres
POSTGRES_USER=dr
POSTGRES_PASSWORD=dr_dev_password
POSTGRES_DB=desafios_reais
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://dr:dr_dev_password@localhost:5432/desafios_reais?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_ADDR=:8080
API_PUBLIC_URL=http://localhost:8080
APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Bootstrap admin (created on first migrate/seed if set)
ADMIN_EMAIL=admin@demo.desafiosreais.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_USERNAME=admin

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (sandbox later — leave empty in S0/S1)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Local media uploads (S3/MinIO later)
MEDIA_DIR=data/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (Resend). O remetente precisa ser um domínio verificado na conta.
RESEND_API_KEY=
EMAIL_FROM="Desafios Reais <noreply@desafiosreais.com>"

# Feature flags defaults
FLAG_PAYMENTS_P2P_PRIZES=false

# Fee to submit a challenge for approval (BRL cents). Default R$ 99,00.
CHALLENGE_SUBMISSION_FEE_CENTS=9900
